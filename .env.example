# Telegram bot that sends messages to subscribers
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Bot used for error/log reporting
LOG_BOT_TOKEN=your-log-bot-token
LOG_CHAT_ID=your-log-chat-id

# Chat ID of the mentor/group channel where poll & button answers are mirrored.
# Required for group notifications; if unset, group notifications fail closed with an error.
LOG_GROUP_CHAT_ID=your-log-group-chat-id

# Vercel Postgres connection string
DATABASE_URL=your-database-url

# Public base URL used when registering the Telegram webhook (e.g. https://example.com)
WEBHOOK_URL=your-webhook-url

# Optional admin guard for privileged API routes (/api/send*, /api/migrate, /api/webhook/setup).
# When unset, those routes behave exactly as before (no auth).
# When set, requests must send header: Authorization: Bearer <ADMIN_SECRET>
ADMIN_SECRET=your-admin-secret
